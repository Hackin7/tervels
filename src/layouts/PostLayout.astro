---
import BaseLayout from './BaseLayout.astro';
import CountryFlag from '../components/CountryFlag.astro';
import { Image } from 'astro:assets';
import type { Post } from '../lib/aggregates';
import { countrySlug, isLocationResolved, primaryLocation } from '../lib/aggregates';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { youtubeItemTitle, type YouTubeItem } from '../lib/youtube';
import { standaloneYouTubeItems, youtubeItemKey } from '../lib/youtube-core.mjs';
interface Props { post: Post; }
const { post } = Astro.props;
const dateStr = post.data.timestamp.toISOString().slice(0, 10);
const primary = primaryLocation(post);
const country = countrySlug(primary.country);
const base = import.meta.env.BASE_URL;
const resolved = isLocationResolved(post);
const gallery = post.data.gallery.filter(photo => photo.src !== post.data.cover?.src);
const locationLinks = post.data.locations.map(location => ({
  location,
  country: countrySlug(location.country),
  mapsUrl: location.gps ? `https://www.google.com/maps/search/?api=1&query=${location.gps[0]},${location.gps[1]}` : null,
}));
const youtube = post.data.youtube;
const youtubeCover = youtube?.cover;
const topItems: YouTubeItem[] = [];
const seenYouTubeItems = new Set<string>();
const addYouTubeItem = (item: YouTubeItem) => {
  const key = youtubeItemKey(item);
  if (seenYouTubeItems.has(key)) return;
  seenYouTubeItems.add(key);
  topItems.push(item);
};
if (youtubeCover) addYouTubeItem({ kind: 'video', id: youtubeCover });
for (const item of (youtube?.items ?? []) as YouTubeItem[]) addYouTubeItem(item);
for (const item of standaloneYouTubeItems(post.body ?? '') as YouTubeItem[]) addYouTubeItem(item);
---
<BaseLayout title={`${post.data.title} · tervels`}>
  {resolved ? (
    <p class="muted">
      <a href={`${base}/places`}>places</a> ›
      <a href={`${base}/places/${country}`}><CountryFlag code={country} /></a> ›
      <a href={`${base}/places/${country}/${primary.city_slug}`}>{primary.city}</a>
    </p>
  ) : (
    <p class="muted">
      <a href={`${base}/triage`}>triage</a> · <span style="background:#fde68a; color:#92400e; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:999px;">needs location</span>
    </p>
  )}
  <h1>{post.data.title}</h1>
  <p class="muted">
    {dateStr}
  </p>
  {resolved && (
    <ul class="muted" style="list-style:none; padding:0; margin:0.35rem 0 1rem; display:flex; flex-wrap:wrap; gap:0.35rem 0.8rem;">
      {locationLinks.map(({ location, country, mapsUrl }) => (
        <li>
          <a href={`${base}/places/${country}/${location.city_slug}`}>{location.name}</a>
          {mapsUrl && <> · <a href={mapsUrl}>GPS</a></>}
        </li>
      ))}
    </ul>
  )}
  {post.data.cover && (
    <a href={post.data.cover.src} target="_blank" rel="noopener noreferrer">
      <Image src={post.data.cover} alt={post.data.title} width={1040} height={640} style="border-radius:8px; margin:1rem 0;" />
    </a>
  )}
  {topItems.length > 0 && (
    <section class="post-videos">
      <h2>Videos</h2>
      <div class="youtube-gallery">
        {topItems.map(item => <YouTubeEmbed item={item} title={youtubeItemTitle(item)} />)}
      </div>
    </section>
  )}
  <article>
    <slot />
  </article>
  {gallery.length > 0 && (
    <section class="post-photos" aria-label="Photos">
      <h2>Photos</h2>
      <div class="photo-gallery">
        {gallery.map((photo, index) => (
          <a href={photo.src} target="_blank" rel="noopener noreferrer">
            <Image src={photo} alt={`Photo ${index + 1} from ${post.data.title}`} width={Math.min(600, photo.width)} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </section>
  )}
  {!resolved && (
    <aside style="margin-top:2rem; padding:1rem; background:#fef3c7; border-radius:8px;">
      <strong>To publish this post:</strong> open <code>{post.id}/index.md</code> and set
      <code>locations[0].country</code> (country name like <code>Japan</code>),
      <code>locations[0].city</code>, <code>locations[0].city_slug</code>,
      and ideally <code>locations[0].gps</code>.
    </aside>
  )}
</BaseLayout>

<style>
  .post-photos { margin-top: 2rem; }
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 0.75rem;
    align-items: start;
  }
  .photo-gallery a { display: block; }
  .photo-gallery img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>
